# Mẫu biến môi trường cho production. Cách dùng:  cp .env.prod.example .env  rồi điền giá trị thật.
# File .env chứa bí mật: KHÔNG commit (đã nằm trong .gitignore), chmod 600 trên VPS.

# ---------- Bắt buộc ----------
# Địa chỉ công khai của web, phải là https (dùng để tạo link trong email)
ALOUTE_BASE_URL=https://aloute.example.com
# Khóa ký JWT, sinh bằng:  openssl rand -base64 48
ALOUTE_JWT_SECRET=
# Mật khẩu PostgreSQL, sinh bằng:  openssl rand -base64 24
DB_PASSWORD=
# Tên miền của web, KHÔNG có https:// (Caddy dùng để xin chứng chỉ). Bản ghi A của tên miền phải trỏ về IP của VPS.
DOMAIN=aloute.example.com
# Email nhận thông báo từ Let's Encrypt (nhắc nếu gia hạn chứng chỉ gặp sự cố)
ACME_EMAIL=

# Chỉ điền khi BẬT proxy Cloudflare (đám mây cam). Để trống nếu bản ghi DNS là DNS only (đám mây xám).
# Lấy giá trị bằng:  ./deploy/cloudflare-ips.sh
CADDY_TRUSTED_PROXIES=

# ---------- Tài khoản admin (chỉ đặt ở LẦN CHẠY ĐẦU) ----------
# Có ALOUTE_SEED_PASSWORD thì app tạo admin nếu chưa có. Sau khi đăng nhập được, XÓA dòng mật khẩu này rồi khởi động lại.
# Mật khẩu ≥ 12 ký tự. Dùng email THẬT của bạn để còn dùng được "Quên mật khẩu".
ALOUTE_SEED_PASSWORD=
ALOUTE_SEED_ADMIN_EMAIL=

# ---------- Email quên mật khẩu (SMTP) ----------
# Brevo:  MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  MAIL_USER=<email đăng nhập Brevo>  MAIL_PASSWORD=<SMTP key>
# Resend: MAIL_HOST=smtp.resend.com       MAIL_PORT=587  MAIL_USER=resend                  MAIL_PASSWORD=<API key>
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Địa chỉ người gửi, phải thuộc domain đã xác minh ở Brevo/Resend
ALOUTE_MAIL_FROM=no-reply@aloute.example.com

# ---------- Đăng nhập Google/Facebook (Firebase Authentication, miễn phí, KHÔNG cần thẻ) ----------
# Để trống toàn bộ khối này nếu chưa dùng: nút Google/Facebook sẽ hiện trạng thái tắt, phần còn lại vẫn chạy đủ.
# Khi dùng: đặt file service account vào thư mục ./secrets trên VPS rồi điền đường dẫn TRONG container, ví dụ
#   FIREBASE_CREDENTIALS=/run/secrets/firebase-adminsdk.json
FIREBASE_CREDENTIALS=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=

# Ảnh người dùng lưu trên đĩa VPS (Docker volume "uploads"), không cần cấu hình gì thêm.
